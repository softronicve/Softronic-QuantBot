# Copy to .env and edit. Every setting is optional: with an empty file the bot
# runs in DRY_RUN with a 10,000 USDT paper account. Never put a comment after an
# empty value: docker compose would read the comment as the value.

# --- Safety switches ---------------------------------------------------------
BOT_DRY_RUN=true                               # master switch: while true, nothing reaches a real account
BOT_FUTURES__EXECUTION_MODE=DRY_RUN            # DRY_RUN | TESTNET | LIVE
BOT_FUTURES__LIVE_TRADING_ACKNOWLEDGED=false   # LIVE needs this set to true AND BOT_DRY_RUN=false

# --- Binance USDT-M Futures credentials (TESTNET and LIVE only) ---------------
# Testnet keys come from https://testnet.binancefuture.com and are different from live keys.
BOT_FUTURES__API_KEY=
BOT_FUTURES__API_SECRET=

# --- Daily cycle -------------------------------------------------------------
#BOT_PAPER_CAPITAL=10000                       # starting balance of the paper account (first run only)
#BOT_FUTURES__SYMBOLS=BTCUSDT,ETHUSDT,...      # basket, comma separated contract names (1000PEPEUSDT, not PEPEUSDT)
#BOT_FUTURES__CANDLES=500                      # closed daily candles requested per symbol
#BOT_FUTURES__LEVERAGE=1                       # leverage set on the exchange; with 1 nothing is borrowed
#BOT_FUTURES__RUN_DELAY_SECONDS=90             # seconds after 00:00 UTC at which the cycle starts
#BOT_FUTURES__MAX_ENTRY_DELAY_MINUTES=360      # past this delay the cycle closes positions but does not open new ones
#BOT_FUTURES__RISK_PCT=1                       # % of the balance at risk per position
#BOT_FUTURES__MAX_POSITION_FRACTION=0.1        # largest value of one position, as a multiple of the balance
#BOT_FUTURES__MAX_HEAT_PCT=4                   # largest open risk of the whole portfolio, in %
#BOT_STATE_DIR=data                            # where cycles, paper account and reports are kept

# --- Dashboard ---------------------------------------------------------------
#BOT_DASHBOARD__HOST=127.0.0.1
#BOT_FUTURES__DASHBOARD_PORT=8770
#BOT_FUTURES__PANEL_EXTERNAL_DATA=true         # false = the dashboard asks nothing outside Binance (no headlines, no calendar)

# --- Telegram alerts (python -m src.engine.notifier --chats | --test) ---------
# bot token from @BotFather; empty = no alerts
BOT_TELEGRAM__BOT_TOKEN=
# chat that receives them; --chats prints it
BOT_TELEGRAM__CHAT_ID=
#BOT_TELEGRAM__QUIET_DAYS=true                 # false = only alert on buys, sells, stops and failures

# --- Logging -----------------------------------------------------------------
#BOT_LOG_LEVEL=INFO
#BOT_LOG_JSON=false
#BOT_LOG_FILE=                                 # if set, log to this file instead of the console
